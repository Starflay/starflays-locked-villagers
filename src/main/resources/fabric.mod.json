  "environment": "*",
  "mixins": [
    "starflays_locked_villagers.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.1.1",
    "java": ">=25",
    "fabric-api": "*"
